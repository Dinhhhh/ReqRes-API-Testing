
{
  "info": {
    "name": "ReqRes Performance Monitor",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET Users - Availability and SLA",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{api-key}}"
          }
        ],
        "url": {
          "raw": "https://reqres.in/api/users?page=1",
          "protocol": "https",
          "host": ["reqres", "in"],
          "path": ["api", "users"],
          "query": [
            {
              "key": "page",
              "value": "1"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Availability - Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Performance - Response time below 800ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(800);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
